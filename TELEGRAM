# ---------- Шифрование ----------
def encrypt_id(user_id: int) -> str:
    return fernet.encrypt(str(user_id).encode()).decode()

def decrypt_id(encrypted: str) -> int:
    return int(fernet.decrypt(encrypted.encode()).decode())

# ---------- Модели ----------
class User(Base):
    __tablename__ = "users"
    id = Column(BigInteger, primary_key=True)
    encrypted_partner = Column(String(255), nullable=True)
    is_premium = Column(Boolean, default=False)
    premium_until = Column(DateTime, nullable=True)
    search_gender = Column(String(10), nullable=True)
    search_age_max = Column(Integer, nullable=True)
    room = Column(String(50), default="default")
    banned_until = Column(DateTime, nullable=True)
    created_at = Column(DateTime, default=datetime.datetime.utcnow)

    @property
    def current_partner(self):
        if self.encrypted_partner:
            return decrypt_id(self.encrypted_partner)
        return None

    @current_partner.setter
    def current_partner(self, value):
        if value is None:
            self.encrypted_partner = None
        else:
            self.encrypted_partner = encrypt_id(value)

class ChatSession(Base):
    __tablename__ = "chat_sessions"
    id = Column(Integer, primary_key=True)
    encrypted_user1 = Column(String(255), nullable=False)
    encrypted_user2 = Column(String(255), nullable=False)
    started_at = Column(DateTime, default=datetime.datetime.utcnow)
    ended_at = Column(DateTime, nullable=True)
    session_token = Column(String(64), unique=True, nullable=False)

