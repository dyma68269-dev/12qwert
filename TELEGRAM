async def get_or_create_user(user_id: int, db: AsyncSession):
    user = await db.execute(select(User).where(User.id == user_id))
    user = user.scalar_one_or_none()
    if not user:
        user = User(id=user_id)
        db.add(user)
        await db.commit()
        await db.refresh(user)
    return user

async def clear_user_data(user_id: int, db: AsyncSession):
    waiting_users.pop(user_id, None)
    user = await db.execute(select(User).where(User.id == user_id))
    user = user.scalar_one_or_none()
    if user and user.current_partner:
        partner_id = user.current_partner
        partner = await db.execute(select(User).where(User.id == partner_id))
        partner = partner.scalar_one_or_none()
        if partner:
            partner.current_partner = None
        session = await db.execute(select(ChatSession).where(
            ((ChatSession.encrypted_user1 == encrypt_id(user_id)) | (ChatSession.encrypted_user2 == encrypt_id(user_id))) &
            (ChatSession.ended_at.is_(None))
        ))
        session = session.scalar_one_or_none()
        if session:
            session.ended_at = datetime.datetime.utcnow()
    await db.execute(delete(User).where(User.id == user_id))
    await db.execute(delete(ChatSession).where(
        (ChatSession.encrypted_user1 == encrypt_id(user_id)) | (ChatSession.encrypted_user2 == encrypt_id(user_id))
    ))
    await db.commit()

waiting_users = {}

async def try_match(user_id: int, bot: Bot):
    prefs = waiting_users.get(user_id)
    if not prefs:
        return
    for uid, other_prefs in list(waiting_users.items()):
        if uid == user_id:
            continue
        if other_prefs["room"] == prefs["room"]:
            target = uid
            token = generate_session_token()
            async with AsyncSessionLocal() as db:
                session = ChatSession(
                    encrypted_user1=encrypt_id(user_id),
                    encrypted_user2=encrypt_id(target),
                    session_token=token
                )
                db.add(session)
                user1 = await get_or_create_user(user_id, db)
                user2 = await get_or_create_user(target, db)
                user1.current_partner = target
                user2.current_partner = user_id
                await db.commit()
            waiting_users.pop(user_id, None)
            waiting_users.pop(target, None)
            await bot.send_message(user_id, "✅ Собеседник найден! Пишите анонимно.\n🎥 /call для видеозвонка\n🚪 /stop для выхода")
            await bot.send_message(target, "✅ Собеседник найден! Пишите анонимно.\n🎥 /call для видеозвонка\n🚪 /stop для выхода")
            return

