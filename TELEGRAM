def hash_user_id(user_id: int) -> str:
    return hashlib.blake2b(f"{user_id}{SECRET_KEY}".encode(), digest_size=8).hexdigest()

def sign_data(data: str) -> str:
    signature = hmac.new(SECRET_KEY, data.encode(), hashlib.sha256).hexdigest()[:16]
    return f"{data}:{signature}"

def verify_signed_data(signed: str) -> str | None:
    try:
        data, signature = signed.rsplit(":", 1)
        expected = hmac.new(SECRET_KEY, data.encode(), hashlib.sha256).hexdigest()[:16]
        if hmac.compare_digest(signature, expected):
            return data
    except:
        return None
    return None

def generate_session_token() -> str:
    return secrets.token_urlsafe(32)

rate_cache = defaultdict(list)

class RateLimitMiddleware(BaseMiddleware):
    async def __call__(self, handler, event: types.TelegramObject, data: dict):
        user_id = None
        if isinstance(event, (types.Message, types.CallbackQuery)):
            user_id = event.from_user.id
        if user_id:
            now = time.time()
            rate_cache[user_id] = [t for t in rate_cache[user_id] if now - t < 1]
            if len(rate_cache[user_id]) >= 5:
                if isinstance(event, types.Message):
                    await event.answer("⏳ Слишком много запросов. Подождите.")
                elif isinstance(event, types.CallbackQuery):
                    await event.answer("⏳ Слишком много запросов.", show_alert=False)
                return
            rate_cache[user_id].append(now)
        return await handler(event, data)

