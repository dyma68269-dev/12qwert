@dp.callback_query()
async def handle_callback(cb: types.CallbackQuery):
    original = verify_signed_data(cb.data)
    if not original:
        await cb.answer("❌ Ошибка", show_alert=True)
        return
    async with AsyncSessionLocal() as db:
        user = await get_or_create_user(cb.from_user.id, db)
        if "gender" in original:
            gender = original.split("_")[2] if len(original.split("_")) > 2 else "any"
            user.search_gender = gender if gender != "any" else None
            await db.commit()
            await cb.answer(f"Пол: {gender}", show_alert=False)
        elif "age" in original:
            age_param = original.split("_")[2]
            if age_param == "under25":
                user.search_age_max = 25
            elif age_param == "25_35":
                user.search_age_max = 35
            else:
                user.search_age_max = None
            await db.commit()
            await cb.answer("Возраст сохранён", show_alert=False)
        elif original == "search_apply":
            await db.commit()
            await cb.answer("Настройки сохранены!", show_alert=False)
            await cb.message.edit_text("✅ Критерии поиска обновлены.")
            return
    await cb.message.edit_text("✅ Настройки обновлены.")

@dp.message()
async def relay_message(msg: types.Message):
    user_id = msg.from_user.id
    async with AsyncSessionLocal() as db:
        user = await get_or_create_user(user_id, db)
        partner = user.current_partner
        if not partner:
            return
        if msg.text:
            safe_text = html.escape(msg.text)
            await bot.send_message(partner, safe_text)
        elif msg.photo:
            await bot.send_photo(partner, msg.photo[-1].file_id, caption=html.escape(msg.caption or ""))
        elif msg.video:
            await bot.send_video(partner, msg.video.file_id, caption=html.escape(msg.caption or ""))
        elif msg.voice:
            await bot.send_voice(partner, msg.voice.file_id)
        else:
            await msg.copy_to(partner)

